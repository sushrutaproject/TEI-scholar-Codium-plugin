            <div xml:id="SS.1.1" type="adhyaya">
                <lg xml:id="SS.1.1.1">
                    <l>athāto vedotpattim adhyāyaṃ vyākhyāsyāmaḥ</l>
                    <l>yathovāca bhagavān dhanvantariḥ</l>
                </lg>
                <lg xml:id="SS.1.1.2">
                    <l>atha khalu bhagavantam amaravaram ṛṣigaṇaparivṛtam</l>
                    <l>āśramastham kāśirājaṃ divodāsaṃ dhanvantarim</l>
                </lg>
                <lg xml:id="SS.1.1.3">
                    <l>aupadhenava-vaitaraṇa-aurabhra-pauṣkalāvata</l>
                </lg>
            </div>
        </body>
    </text>
